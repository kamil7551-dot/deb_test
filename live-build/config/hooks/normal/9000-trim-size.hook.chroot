#!/bin/sh
# Keep the ISO under 1 GB: drop docs, man pages, foreign translations and firmware for hardware
# that never appears in laptops/desktops (server NICs, ARM SoCs). NVIDIA GSP firmware is only used by
# the nova/nouveau GSP path on RTX cards and is >100 MB; the tester works without it.
set -e
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/lintian/* /usr/share/linda/* || true
find /usr/share/locale -mindepth 1 -maxdepth 1 -type d ! -name 'pl*' ! -name 'en*' -exec rm -rf {} + || true
FW=/usr/lib/firmware
rm -rf $FW/nvidia/*/gsp $FW/qed $FW/bnx2x $FW/liquidio $FW/mellanox $FW/mrvl/prestera $FW/cxgb4 \
       $FW/netronome $FW/qcom/sm8* $FW/qcom/sc8280xp $FW/qcom/sdm845 $FW/qcom/sa8775p $FW/dpaa2 \
       $FW/ti-keystone $FW/inside-secure 2>/dev/null || true
apt-get clean
rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin
find /usr/lib/python3* -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true
